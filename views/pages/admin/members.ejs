<%- include("../../partials/header") %>
    <%- include("../../partials/navbar") %>

        <div class="container py-4">

            <!-- Header -->

            <div class="d-flex justify-content-between
                align-items-center mb-4">

                <div>
                    <h2 class="fw-bold mb-1">
                        Admin Members
                    </h2>

                    <p class="text-muted mb-0">
                        Manage admin and sub-admin accounts
                    </p>
                </div>

                <a href="/admin/members/create" class="btn btn-primary">

                    <i class="bi bi-person-plus"></i>
                    Create Sub Admin

                </a>

            </div>


            <!-- Admin Members -->

            <div class="card border-0 shadow-sm">

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover
                              align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Permissions</th>
                                    <th>Actions</th>

                                </tr>

                            </thead>

                            <tbody>

                                <% if (admins.length> 0) { %>

                                    <% admins.forEach(admin=> { %>

                                        <tr>

                                            <td>
                                                <strong>
                                                    <%= admin.name %>
                                                </strong>
                                            </td>

                                            <td>
                                                <%= admin.email %>
                                            </td>

                                            <td>

                                                <% if ( admin.role==="admin" ) { %>

                                                    <span class="badge bg-danger">
                                                        Main Admin
                                                    </span>

                                                    <% } else { %>

                                                        <span class="badge bg-primary">
                                                            Sub Admin
                                                        </span>

                                                        <% } %>

                                            </td>

                                            <td>

                                                <% if ( admin.isMainAdmin ) { %>

                                                    <span class="badge bg-success">
                                                        Full Access
                                                    </span>

                                                    <% } else { %>

                                                        <span class="badge bg-warning text-dark">
                                                            Restricted
                                                        </span>

                                                        <% } %>

                                            </td>

                                            <td>

                                                <% if ( admin.permissions && admin.permissions.length> 0
                                                    ) { %>

                                                    <% admin.permissions.forEach( permission=> {
                                                        %>

                                                        <span class="badge bg-light
                                                             text-dark
                                                             border me-1">

                                                            <%= permission %>

                                                        </span>

                                                        <% }) %>

                                                            <% } else if ( admin.isMainAdmin ) { %>

                                                                <span class="text-muted">
                                                                    All permissions
                                                                </span>

                                                                <% } else { %>

                                                                    <span class="text-muted">
                                                                        No permissions
                                                                    </span>

                                                                    <% } %>

                                            </td>
                                            <td>

                                                <% if (admin.role==="subadmin" ) { %>

                                                    <div class="d-flex gap-2">

                                                        <a href="/admin/members/edit/<%= admin._id %>"
                                                            class="btn btn-sm btn-outline-primary">

                                                            <i class="bi bi-pencil"></i>
                                                            Edit

                                                        </a>


                                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                            onclick="deleteSubAdmin('<%= admin._id %>')">

                                                            <i class="bi bi-trash"></i>
                                                            Delete

                                                        </button>

                                                    </div>

                                                    <% } else { %>

                                                        <span class="text-muted">
                                                            Protected
                                                        </span>

                                                        <% } %>

                                            </td>

                                        </tr>

                                        <% }) %>

                                            <% } else { %>

                                                <tr>

                                                    <td colspan="5" class="text-center py-4 text-muted">

                                                        No admin members found.

                                                    </td>

                                                </tr>

                                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
<script>

async function deleteSubAdmin(id) {

    const confirmed = confirm(
        "Are you sure you want to delete this Sub Admin?"
    );

    if (!confirmed) {
        return;
    }


    try {

        const response = await fetch(
            `/admin/members/delete/${id}`,
            {
                method: "POST"
            }
        );


        const result = await response.json();


        if (result.success) {

            alert(result.message);

            window.location.reload();

        } else {

            alert(result.message);

        }

    } catch (error) {

        console.error(error);

        alert(
            "Something went wrong while deleting Sub Admin."
        );

    }

}

</script>
        <%- include("../../partials/footer") %>