<%- include("../../partials/header") %>
<%- include("../../partials/navbar") %>

<div class="container my-5">
<h2 class="mb-4">
    Product List
</h2>

<table class="table table-bordered table-hover">

    <thead>

        <tr>

            <th>#</th>

            <th>Image</th>

            <th>Name</th>

            <th>Category</th>

            <th>Price</th>

            <th>Stock</th>

            <th>Status</th>

            <th>Action</th>

        </tr>

    </thead>

    <tbody>

        <% products.forEach((product, index) => { %>

            <tr id="row-<%= product._id %>">

                <td>
                    <%= index + 1 %>
                </td>

                <td>
                    <img
                        src="<%= product.image %>"
                        width="70"
                        alt="<%= product.name %>"
                    >
                </td>

                <td>
                    <%= product.name %>
                </td>

                <td>
                    <%= product.category %>
                </td>

                <td>
                    ৳ <%= product.price %>
                </td>

                <!-- Stock -->
                <td>

                    <strong>
                        <%= product.stock %>
                    </strong>

                    units

                </td>

                <!-- Stock Status -->
                <td>

                    <% if (product.stock === 0) { %>

                        <span class="badge bg-danger">
                            Out of Stock
                        </span>

                    <% } else if (product.stock <= 5) { %>

                        <span class="badge bg-warning text-dark">
                            Low Stock
                        </span>

                    <% } else { %>

                        <span class="badge bg-success">
                            In Stock
                        </span>

                    <% } %>

                </td>

                <td>

                    <a
                        href="/admin/edit-product/<%= product._id %>"
                        class="btn btn-warning btn-sm"
                    >
                        Edit
                    </a>

                    <button
                        class="btn btn-danger btn-sm delete-product"
                        data-id="<%= product._id %>"
                        data-url="/admin/delete-product/<%= product._id %>"
                    >

                        <i class="bi bi-trash"></i>
                        Delete

                    </button>

                </td>

            </tr>

        <% }); %>

    </tbody>

</table>


</div>

<%- include("../../partials/footer") %>
