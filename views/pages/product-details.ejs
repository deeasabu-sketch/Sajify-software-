<%- include("../partials/header") %>
    <%- include("../partials/navbar") %>

        <section class="container my-5">

            ```
            <div class="row">

                <div class="col-md-6">

                    <img src="<%= product.image %>" alt="<%= product.name %>" class="img-fluid rounded shadow">

                </div>

                <div class="col-md-6">

                    <h2 class="fw-bold">
                        <%= product.name %>
                    </h2>

                    <h4 class="text-success my-3">
                        ৳ <%= product.price %>
                    </h4>

                    <span class="badge bg-primary mb-3">
                        <%= product.category %>
                    </span>

                    <p class="mt-3">
                        <%= product.description %>
                    </p>


                    <div class="mt-4">

                        <!-- Add to Cart -->
                        <!-- Stock Status -->

                        <div class="mb-3">

                            ```
                            <% if (product.stock <=0) { %>

                                <span class="badge bg-danger fs-6">
                                    Out of Stock
                                </span>

                                <% } else if (product.stock <=5) { %>

                                    <span class="badge bg-warning text-dark fs-6">
                                        Only <%= product.stock %> left in stock
                                    </span>

                                    <% } else { %>

                                        <span class="badge bg-success fs-6">
                                            In Stock
                                        </span>

                                        <% } %>
                                            ```

                        </div>

                        <!-- Add to Cart -->

                        <% if (product.stock> 0) { %>

                            
                            <form action="/cart/add/<%= product._id %>" method="POST">

                                <div class="mb-3">

                                    <label for="quantity" class="form-label">
                                        Quantity
                                    </label>

                                    <input type="number" id="quantity" name="quantity" class="form-control" value="1"
                                        min="1" max="<%= product.stock %>" style="max-width: 150px;" required>

                                    <div class="form-text">
                                        Maximum available: <%= product.stock %>
                                    </div>

                                </div>

                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-cart-plus"></i>
                                    Add to Cart
                                </button>

                            </form>
                            

                            <% } else { %>

                               
                                <button type="button" class="btn btn-secondary" disabled>
                                    <i class="bi bi-cart-x"></i>
                                    Out of Stock
                                </button>
                                

                                <% } %>



                                    <!-- Add to Wishlist -->
                                    <% if (currentUser) { %>

                                        <form action="/wishlist/add/<%= product._id %>" method="POST" class="mt-2">

                                            <button type="submit" class="btn btn-outline-danger">

                                                <i class="bi bi-heart"></i>
                                                Add to Wishlist

                                            </button>

                                        </form>

                                        <% } %>


                                            <!-- Buy Now -->
                                            <button class="btn btn-success btn-lg mt-3">
                                                Buy Now
                                            </button>

                    </div>

                </div>

            </div>
            ```

        </section>

        <%- include("../partials/footer") %>