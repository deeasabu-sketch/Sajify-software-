<%- include("../partials/header") %>
    <%- include("../partials/navbar") %>
        <% if (currentUser) { %>

            <div class="container mt-3">
                <div class="alert alert-success">
                    Welcome, <strong>
                        <%= currentUser.name %>
                    </strong>
                </div>
            </div>

            <% } %>

                <section class="hero py-5">
                    <div class="container">
                        <div class="row align-items-center">

                            <div class="col-lg-6">
                                <div class="hero-content">

                                    <span class="hero-badge">
                                        <i class="bi bi-stars"></i>
                                        Your Smart Shopping Destination
                                    </span>

                                    <h1 class="display-3 fw-bold mt-3">
                                        Welcome to
                                        <span class="text-primary">Sajify</span>
                                    </h1>

                                    <p class="lead text-muted mt-3">
                                        Discover amazing products, great prices,
                                        and a better way to shop online.
                                    </p>

                                    <div class="d-flex flex-wrap gap-3 mt-4">

                                        <a href="/shop" class="btn btn-primary btn-lg px-4">
                                            <i class="bi bi-bag-heart"></i>
                                            Explore Products
                                        </a>

                                        <a href="/about" class="btn btn-outline-primary btn-lg px-4">
                                            Learn More
                                            <i class="bi bi-arrow-right"></i>
                                        </a>

                                    </div>

                                </div>

                            </div>

                            <div class="col-lg-6 text-center">
                                <img src="https://picsum.photos/700/500" class="img-fluid rounded shadow">
                            </div>

                        </div>
                    </div>
                </section>




                <section id="featured-products" class="container my-5">

                    <h2 class="mb-4 text-center">
                        Featured Products
                    </h2>

                    <!-- Search -->
                    <div class="row mb-4">
                        <div class="col-md-8 mx-auto">

                            <div class="input-group">
                                <input type="text" id="productSearch" class="form-control"
                                    placeholder="Search products..." autocomplete="off">
                            </div>

                        </div>
                    </div>

                    <!-- Product Grid -->
                    <div class="row g-4">

                        <% products.forEach(product=> { %>

                            <div class="col-6 col-md-4 col-lg-3">

                                <div class="card h-100 shadow-sm position-relative product-card">

                                    <!-- Discount Badge -->
                                    <% if (product.discountPercent> 0) { %>

                                        <span class="position-absolute top-0 start-0 badge bg-danger m-2"
                                            style="z-index: 2;">
                                            <%= product.discountPercent %>% OFF
                                        </span>

                                        <% } %>


                                            <!-- Product Image -->
                                            <div class="product-image-wrapper">

                                                <img src="<%= product.image %>" class="img-fluid product-hover-image"
                                                    alt="<%= product.name %>">

                                            </div>


                                            <!-- Product Info -->
                                            <div class="card-body d-flex flex-column">

                                                <!-- Product Name -->
                                                <h5 class="card-title">
                                                    <%= product.name %>
                                                </h5>


                                                <!-- Category -->
                                                <p class="text-muted mb-2">
                                                    <%= product.category %>
                                                </p>


                                                <!-- Price -->
                                                <% if ( product.discountPercent> 0 &&
                                                    product.discountPrice < product.price ) { %>

                                                        <div class="mb-3">

                                                            <span class="text-muted text-decoration-line-through me-2">
                                                                ৳ <%= product.price %>
                                                            </span>

                                                            <span class="text-success fw-bold">
                                                                ৳ <%= product.discountPrice %>
                                                            </span>

                                                        </div>

                                                        <% } else { %>

                                                            <h5 class="text-success mb-3">
                                                                ৳ <%= product.price %>
                                                            </h5>

                                                            <% } %>


                                                                <!-- View Details -->
                                                                <a href="/product/<%= product._id %>"
                                                                    class="btn btn-primary mt-auto">
                                                                    View Details
                                                                </a>

                                            </div>

                                </div>

                            </div>

                            <% }) %>

                    </div>



                    <!-- Load More -->

                    <div class="d-flex justify-content-center align-items-center gap-4 mt-5">

                        <button id="prevPageBtn" class="btn btn-outline-primary" disabled>
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        <span id="pageInfo" class="fw-semibold">
                            Page 1
                        </span>

                        <button id="nextPageBtn" class="btn btn-outline-primary">
                            <i class="bi bi-chevron-right"></i>
                        </button>

                    </div>



                </section>




                <%- include("../partials/footer") %>
                    <script src="/js/home.js"></script>