<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<div class="container my-5">

    <h2 class="mb-4">
        <i class="bi bi-cart3"></i>
        Shopping Cart
    </h2>


    <% if (!cart || cart.items.length === 0) { %>

        <!-- Empty Cart -->
        <div class="text-center py-5">

            <i class="bi bi-cart-x display-1 text-muted"></i>

            <h4 class="mt-3">
                Your cart is empty
            </h4>

            <p class="text-muted">
                Add some products to your cart.
            </p>

            <a href="/" class="btn btn-primary">
                Continue Shopping
            </a>

        </div>


    <% } else { %>

        <div class="row g-4">

            <!-- ========================= -->
            <!-- Cart Items -->
            <!-- ========================= -->

            <div class="col-lg-8">

                <% cart.items.forEach(item => { %>

                    <%
                        const finalPrice =
                            item.product.discountPercent > 0
                                ? item.product.discountPrice
                                : item.product.price;
                    %>

                    <div
                        class="card mb-3 shadow-sm cart-item"
                        data-price="<%= finalPrice %>"
                        data-stock="<%= item.product.stock %>"
                    >

                        <div class="card-body">

                            <div class="row align-items-center g-3">

                                <!-- Product Image -->
                                <div class="col-4 col-md-2">

                                    <img
                                        src="<%= item.product.image %>"
                                        alt="<%= item.product.name %>"
                                        class="img-fluid rounded"
                                    >

                                </div>


                                <!-- Product Information -->
                                <div class="col-8 col-md-4">

                                    <h5 class="mb-1">
                                        <%= item.product.name %>
                                    </h5>

                                    <p class="text-muted mb-1">
                                        <%= item.product.category %>
                                    </p>


                                    <!-- Price -->
                                    <% if (item.product.discountPercent > 0) { %>

                                        <div>

                                            <del class="text-muted">
                                                ৳ <%= item.product.price %>
                                            </del>

                                            <strong class="text-success ms-2">
                                                ৳ <%= finalPrice %>
                                            </strong>

                                        </div>

                                        <span class="badge bg-danger mt-1">
                                            <%= item.product.discountPercent %>% OFF
                                        </span>

                                    <% } else { %>

                                        <strong class="text-success">
                                            ৳ <%= item.product.price %>
                                        </strong>

                                    <% } %>


                                    <!-- Stock Information -->
                                    <% if (item.product.stock <= 0) { %>

                                        <span class="badge bg-danger d-block mt-2">
                                            Out of Stock
                                        </span>

                                    <% } else if (item.product.stock <= 5) { %>

                                        <span class="badge bg-warning text-dark d-block mt-2">
                                            Only <%= item.product.stock %> left
                                        </span>

                                    <% } else { %>

                                        <small class="text-muted d-block mt-2">
                                            <%= item.product.stock %> available
                                        </small>

                                    <% } %>

                                </div>


                                <!-- Quantity -->
                                <div class="col-6 col-md-3">

                                    <small class="text-muted d-block mb-1">
                                        Quantity
                                    </small>

                                    <div class="d-flex align-items-center">

                                        <!-- Decrease -->
                                        <button
                                            type="button"
                                            class="btn btn-outline-secondary btn-sm decrease-btn"
                                            data-product-id="<%= item.product._id %>"
                                        >
                                            −
                                        </button>


                                        <!-- Quantity -->
                                        <span
                                            class="cart-quantity mx-3 fw-semibold"
                                            id="quantity-<%= item.product._id %>"
                                            data-product-id="<%= item.product._id %>"
                                        >
                                            <%= item.quantity %>
                                        </span>


                                        <!-- Increase -->
                                        <button
                                            type="button"
                                            class="btn btn-outline-secondary btn-sm increase-btn"
                                            data-product-id="<%= item.product._id %>"
                                            <% if (item.quantity >= item.product.stock) { %>
                                                disabled
                                            <% } %>
                                        >
                                            +
                                        </button>

                                    </div>

                                    <small class="text-muted d-block mt-2">
                                        Max: <%= item.product.stock %>
                                    </small>

                                </div>


                                <!-- Total + Remove -->
                                <div class="col-6 col-md-3 text-md-end">

                                    <small class="text-muted d-block mb-1">
                                        Total
                                    </small>

                                    <strong class="text-success item-total">
                                        ৳ <%= finalPrice * item.quantity %>
                                    </strong>


                                    <button
                                        type="button"
                                        class="btn btn-outline-danger btn-sm remove-cart-btn mt-2"
                                        data-product-id="<%= item.product._id %>"
                                    >
                                        <i class="bi bi-trash"></i>
                                        Remove
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>


            <!-- ========================= -->
            <!-- Cart Summary -->
            <!-- ========================= -->

            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h4 class="mb-4">
                            Order Summary
                        </h4>


                        <div class="d-flex justify-content-between mb-3">

                            <span>
                                Subtotal
                            </span>

                            <strong id="cart-subtotal">

                                ৳ <%= cart.items.reduce(
                                    (total, item) => {

                                        const price =
                                            item.product.discountPercent > 0
                                                ? item.product.discountPrice
                                                : item.product.price;

                                        return total +
                                            (price * item.quantity);

                                    },
                                    0
                                ) %>

                            </strong>

                        </div>


                        <hr>


                        <div class="d-flex justify-content-between mb-3">

                            <strong>
                                Total
                            </strong>

                            <strong
                                class="text-success"
                                id="cart-total"
                            >

                                ৳ <%= cart.items.reduce(
                                    (total, item) => {

                                        const price =
                                            item.product.discountPercent > 0
                                                ? item.product.discountPrice
                                                : item.product.price;

                                        return total +
                                            (price * item.quantity);

                                    },
                                    0
                                ) %>

                            </strong>

                        </div>


                        <a
                            href="/checkout"
                            class="btn btn-success w-100"
                        >
                            <i class="bi bi-bag-check"></i>
                            Proceed to Checkout
                        </a>


                        <a
                            href="/"
                            class="btn btn-outline-primary w-100 mt-2"
                        >
                            Continue Shopping
                        </a>

                    </div>

                </div>

            </div>

        </div>

    <% } %>

</div>

<%- include("../partials/footer") %>